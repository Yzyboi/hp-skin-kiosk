# ---------------------------------------------------------------------------
# HP Skin Studio Kiosk - environment configuration
# Copy this file to .env for local development. On the hosting platform
# (Render/Railway), set these as dashboard env vars instead - never commit
# a real .env file.
# ---------------------------------------------------------------------------

# Node environment
NODE_ENV=development
PORT=3000

# Where runtime data (data/stores.json) is read from and written to.
# Local dev: leave unset, or point at the repo's ./data folder.
# Production (Render/Railway): must point at the mounted persistent disk,
# e.g. /data - see README "Hosting / DATA_DIR" section. If this is left
# pointing at the app's working directory in production, every redeploy or
# restart will silently wipe admin-uploaded store data back to the seed file.
DATA_DIR=./data

# Express session signing secret. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Admin console credentials (single shared admin account).
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Gmail SMTP (Nodemailer) - use a Gmail App Password, not your normal
# account password. See README "Gmail App Password" section.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-kiosk-account@gmail.com
SMTP_APP_PASSWORD=replace-with-16-char-app-password
EMAIL_FROM="HP Skin Studio Kiosk" <your-kiosk-account@gmail.com>
EMAIL_REPLY_TO=
